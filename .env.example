# Скопируйте этот файл как .env и заполните значения.
# Никогда не публикуйте реальные токены и ключи.

# KABAN Content Engine. Пока зарегистрирован только CAELUS.
# Если переменная не задана, используется проект caelus.
CONTENT_PROJECT_ID=caelus

TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=-1001234567890

# Используется кнопкой Generate tomorrow / Сгенерировать AI в Review Console.
OPENAI_API_KEY=your_key_here

# Экономичный вариант для ежедневных 12 прогнозов.
CAELUS_OPENAI_MODEL=gpt-5.6-luna

# Для ежедневных прогнозов low обычно достаточно и заметно снижает лишний reasoning.
CAELUS_OPENAI_REASONING_EFFORT=low

# Защита от повторяющихся прогнозов. По умолчанию CAELUS сравнивает каждый знак
# с тем же знаком за предыдущие 90 календарных дней.
CONTENT_HISTORY_DAYS=90
CONTENT_UNIQUENESS_WARNING_THRESHOLD=0.76
CONTENT_UNIQUENESS_HARD_THRESHOLD=0.80
CONTENT_UNIQUENESS_MAX_REGEN_ATTEMPTS=3

# v4.11: эти значения используются как fallback только пока пользователь не сохранил
# профиль Content Diversity в Review Console. После этого настройки берутся из
# generated/_settings/content_diversity.json.

# Optional KABAN scheduler runtime root
# KABAN_RUNTIME_DIR=C:\KABAN\runtime

# Docker production deployment
KABAN_UID=1000
KABAN_GID=1000
KABAN_PUBLIC_URL=http://localhost
KABAN_ADMIN_USER=replace_me
KABAN_ADMIN_PASSWORD_HASH=replace_with_caddy_hash

# Stage 4 — local/cloud persistence selector. Local остаётся default.
# KABAN_PERSISTENCE=local
# KABAN_GENERATED_DIR=/absolute/path/to/generated

# Stage 4 — используются только при KABAN_PERSISTENCE=cloud.
# Не заполняйте реальные значения в этом файле.
# KABAN_SUPABASE_URL=https://replace-me.supabase.co
# KABAN_SUPABASE_SERVICE_KEY=replace_me
# KABAN_R2_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
# KABAN_R2_BUCKET=replace_me
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
