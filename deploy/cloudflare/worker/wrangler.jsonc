{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "kaban-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",

  "keep_vars": true,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },

  "triggers": {
    "crons": []
  },

  "assets": {
    "directory": "./.generated-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "kaban"
    }
  ]
}
